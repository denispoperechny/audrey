# Mission control settings. Copy to .env and fill in; .env is gitignored and not copied into the
# image (.dockerignore). Variables set in the environment win over this file, so in Azure set
# them on the container app instead. Commented-out lines show the defaults.

# ---- The MQTT broker (as for the MQTT logger): telemetry_reader reads, boat_mcp sends commands
MQTT_HOST=your-broker-hostname
MQTT_PORT=10000
MQTT_USER=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
# The broker's certificate, relative to this folder (copy software/mqtt_logger/mqtt_ca.pem here)
MQTT_CA_FILE=mqtt_ca.pem
# TELEMETRY_TOPICS=audrey/boat1/#

# ---- Azure AI Foundry: the captain, the lookout and visual_observe (Entra sign-in: az login
# locally, the managed identity in Azure)
# FOUNDRY_OPENAI_URL=https://temp-test-01-resource.openai.azure.com/openai/v1/
# FOUNDRY_MODEL=gpt-6-astra

# ---- The camera service (latest streamed picture)
# CAMERA_SERVICE_URL=http://camera-service.orangepond-88aa4066.eastus2.azurecontainerapps.io/api

# ---- The boat's MCP tools (boat_mcp)
# BOAT_MCP_PORT=8100
# BOAT_MCP_URL=http://localhost:8100/mcp      # where the captain finds them
# BOAT_MAX_DISTANCE_M=300                     # longest single navigation command

# ---- The captain
# CAPTAIN_SLEEP_S=15                          # from the end of one wake-up to the next
# CAPTAIN_MISSION_FILE=captain/mission.md     # the mission the UI edits
# CAPTAIN_STATE_DIR=/tmp/audrey-captain       # control.json and the captain's log
# CAPTAIN_HOME=captain/home                   # the agent's files (skills/)

# ---- The lookout (camera_observation)
# CAMERA_OBS_PERIOD_S=10
# CAMERA_NOTES_FILE=/tmp/audrey-camera-notes.jsonl

# ---- Telemetry files (telemetry_service)
# TELEMETRY_DIR=/tmp/audrey-telemetry
# TELEMETRY_FILE_SECONDS=30
# TELEMETRY_KEEP_FILES=20

# ---- Traces (tracing.py): what each process did, for reviewing a run
# TRACE_DIR=/tmp/audrey-traces                # "off" turns tracing off
# TRACE_STORAGE_ACCOUNT_URL=https://audreylogs.blob.core.windows.net   # none: the files stay local
# TRACE_STORAGE_CONTAINER=logs                # under mission-control/, as the MQTT logs
# TRACE_UPLOAD_S=30
# TRACE_KEEP_HOURS=24                         # local files, once uploaded

# ---- The mission UI
# MISSION_UI_PORT=8200
