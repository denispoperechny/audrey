# Optional: copy to secrets.toml (gitignored) to use a broker other than the one in the
# boat's electronics/main_controller_esp32_mp/config.py, which is used by default.
[mqtt]
host = "your-broker-hostname"
port = 10000
user = "your-mqtt-username"
password = "your-mqtt-password"
# ca_file = "/path/to/mqtt_ca.pem"  # defaults to the boat's mqtt_ca.pem
