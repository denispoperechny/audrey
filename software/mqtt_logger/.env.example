# Copy to .env and fill in. .env is gitignored. Variables set in the environment win over
# this file. See the top of logger.py for all settings.
MQTT_HOST=your-broker-hostname
MQTT_PORT=10000
MQTT_USER=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
# The broker's certificate, relative to this folder. Not a secret: mqtt_ca.pem is committed.
MQTT_CA_FILE=mqtt_ca.pem
# name=topic filter pairs: each name is a folder in the container (see logger.py)
MQTT_STREAMS=mqtt=audrey/boat1/#,gps-reference=audrey/gps-reference/#
STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
STORAGE_CONTAINER=logs
# LOCAL_OUTPUT_DIR=out    # write files here instead of the storage account, for trying it out
