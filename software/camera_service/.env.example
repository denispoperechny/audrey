# Copy to .env (gitignored). Leave CAMERA_STORAGE_ACCOUNT_URL out to keep everything on the
# local disk instead (CAMERA_DB, CAMERA_PICTURES).
CAMERA_STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
CAMERA_STORAGE_CONTAINER=camera
CAMERA_STREAM_CONTAINER=camera-stream   # pictures the camera pushes without a task
# CAMERA_STREAM_STORE_ALL=true    # store every streamed picture; by default only the ones fetched
# CAMERA_STORAGE_PREFIX=         # a folder inside the container, e.g. for a test setup
# The model get_course_correction asks (an Azure OpenAI deployment in AI Foundry):
FOUNDRY_OPENAI_URL=https://your-foundry-resource.openai.azure.com/openai/v1/
FOUNDRY_MODEL=gpt-6-astra
# CAMERA_REQUIRE_HTTPS=false      # allow plain http for everything (by default only the camera's push)
# The secret every client needs for pictures (X-Visuals-Access header); e.g.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CAMERA_VISUALS_ACCESS=
