# Copy to .env (gitignored). Leave CAMERA_STORAGE_ACCOUNT_URL out to keep everything on the
# local disk instead (CAMERA_DB, CAMERA_PICTURES).
CAMERA_STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
CAMERA_STORAGE_CONTAINER=camera
# CAMERA_STORAGE_PREFIX=         # a folder inside the container, e.g. for a test setup
